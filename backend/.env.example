# Devin API Configuration
DEVIN_API_KEY=your_devin_api_key_here
DEVIN_ORG_ID=your_devin_org_id_here

# GitHub Configuration
GITHUB_WEBHOOK_SECRET=your_default_github_webhook_secret_here
# Note: Each repository can have its own webhook secret in the database
# This is used as a fallback for repositories without specific secrets
GITHUB_TOKEN=your_github_personal_access_token_here

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_main_chat_id_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/devinbot

# Application Configuration
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000